# Backend API port.
PORT=3011

# Local PostgreSQL connection.
# These values must match the PostgreSQL settings in the project-root .env.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=library_db
DB_USER=library_user
DB_PASSWORD=local_dev_password

# Frontend origin allowed to make API requests.
CLIENT_URL=http://localhost:5173

# Required: replace with a random secret of at least 32 bytes.
JWT_SECRET=
